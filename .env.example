APP_ENV=local

# Secret files
SECRET_DIR=.secrets

# PostgreSQL
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=crypto_trading_bot
DATABASE_USER=trading_user
DATABASE_PASSWORD_FILE=.secrets/postgres_password

# OpenAI
OPENAI_API_KEY_FILE=.secrets/openai_api_key
OPENAI_TRADE_MODEL=gpt-5.6-sol
OPENAI_REASONING_EFFORT=medium

# Telegram
TELEGRAM_BOT_TOKEN_FILE=.secrets/telegram_bot_token
TELEGRAM_CHAT_ID=

# Upbit
UPBIT_ACCESS_KEY_FILE=.secrets/upbit_access_key
UPBIT_SECRET_KEY_FILE=.secrets/upbit_secret_key

# Upbit market data
UPBIT_ORDERBOOK_ENABLED=true
UPBIT_ORDERBOOK_COUNT=15

# CoinGecko
COINGECKO_ENABLED=true
COINGECKO_API_BASE_URL=https://api.coingecko.com/api/v3
COINGECKO_API_KEY=
COINGECKO_REQUEST_TIMEOUT_SECONDS=5

# Fear & Greed Index
FEAR_GREED_ENABLED=true
FEAR_GREED_API_BASE_URL=https://api.alternative.me
FEAR_GREED_REQUEST_TIMEOUT_SECONDS=5

# Trading
TRADING_MODE=AI_APPROVAL
ORDER_EXECUTION_MODE=MOCK

MAX_ORDER_AMOUNT_KRW=10000
DAILY_MAX_ORDER_AMOUNT_KRW=30000

ALLOWED_MARKETS=KRW-BTC,KRW-ETH

# Market universe (STATIC is the backward-compatible rollout default)
MARKET_UNIVERSE_MODE=STATIC
MARKET_UNIVERSE_EXCHANGE=UPBIT
MARKET_UNIVERSE_QUOTE_ASSET=KRW
MARKET_UNIVERSE_TOP_N=7
MARKET_UNIVERSE_PREFILTER_N=20
MARKET_UNIVERSE_MIN_24H_TRADE_VALUE_KRW=0
MARKET_UNIVERSE_EXCLUDE_WARNINGS=true
MARKET_UNIVERSE_EXCLUDE_CAUTIONS=true
MARKET_BLOCKLIST=
ANALYSIS_TIMEFRAMES=15m,60m,240m,1d
ANALYSIS_CANDLE_COUNT=50

# DYNAMIC recommendations remain blocked from LIVE unless explicitly enabled.
LIVE_DYNAMIC_MARKET_ENABLED=false

LIVE_ORDER_ENABLED=false
LIVE_ORDER_CONFIRMATION=

# Existing LIVE order GET only. Idle when ORDER_EXECUTION_MODE is not LIVE.
LIVE_ORDER_RECONCILIATION_ENABLED=true
LIVE_ORDER_RECONCILIATION_INTERVAL_SECONDS=60
LIVE_ORDER_RECONCILIATION_BATCH_SIZE=20

# DB-only bot FIFO realized PnL accounting. No exchange/network calls.
BOT_TRADING_PNL_ENABLED=false
BOT_TRADING_PNL_INTERVAL_SECONDS=300

# Operational alerts (pipeline failures remain immediately notified regardless).
OPERATIONAL_ALERTING_ENABLED=false
OPERATIONAL_ALERT_INTERVAL_SECONDS=60
LIVE_ORDER_STALE_ALERT_AFTER_SECONDS=600
OPERATIONAL_ALERT_MAX_RETRIES=3
OPERATIONAL_ALERT_RETRY_DELAYS_MINUTES=1,5,15

# Mock order retry
MOCK_ORDER_RETRY_MAX_RETRIES=3
MOCK_ORDER_RETRY_DELAYS_MINUTES=5,15,30

# Scheduler
AI_ANALYSIS_SCHEDULER_ENABLED=true
AI_ANALYSIS_SCHEDULE_TIMES=09:00
AI_ANALYSIS_RUN_ON_STARTUP=false
